# AKKA MCP Server Configuration

# Base URL of the AKKA API
AKKA_API_BASE=https://api.akka.finance

# Required: API key for AKKA Finance API (get one at https://docs.akka.finance/authentication)
AKKA_API_KEY=your-api-key-here

# Transport mode: "stdio" (default) or "http"
AKKA_MCP_TRANSPORT=stdio

# Port for HTTP transport (only used when transport=http)
AKKA_MCP_PORT=3100

# Request timeout in milliseconds
AKKA_TIMEOUT=15000
