{
  "name": "@akka-finance/mcp-server",
  "version": "1.0.0",
  "mcpName": "io.github.Akka-Finance/mcp-server",
  "description": "MCP server for AKKA DEX aggregator — swap quotes, routes, and execution across EVM chains",
  "type": "module",
  "bin": {
    "akka-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport=http",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dex-aggregator",
    "defi",
    "evm",
    "token-swap",
    "akka-finance"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Akka-Finance/akka-mcp-server"
  },
  "homepage": "https://akka.finance",
  "bugs": {
    "url": "https://github.com/Akka-Finance/akka-mcp-server/issues"
  }
}
